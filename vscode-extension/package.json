{
  "name": "blueprint4llm-vscode",
  "displayName": "Blueprint4llm Preview",
  "description": "Preview blueprint4llm Markdown documents inside Visual Studio Code.",
  "version": "0.1.1",
  "publisher": "blueprint4llm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evgenyigumnov/blueprint4llm.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "categories": [
    "Other"
  ],
  "scripts": {
    "preinstall": "npm --prefix .. run build",
    "build": "npm --prefix .. run build && tsc -p .",
    "vscode:prepublish": "npm run build",
    "test:host": "npm run build && node ./out/test/runTest.js",
    "test:package": "npm run build && node ./scripts/package-smoke.mjs",
    "test": "npm run test:host && npm run test:package",
    "package": "vsce package"
  },
  "dependencies": {
    "blueprint4llm": "file:.."
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3",
    "yauzl": "^3.2.1"
  }
}
