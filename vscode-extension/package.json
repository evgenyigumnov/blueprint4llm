{
  "name": "blueprint4llm-vscode",
  "type": "module",
  "displayName": "Blueprint4llm Preview",
  "description": "Preview blueprint4llm Markdown documents inside Visual Studio Code.",
  "version": "0.6.0",
  "publisher": "blueprint4llm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evgenyigumnov/blueprint4llm.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCommand:blueprint4llm.openPreview",
    "onCommand:blueprint4llm.exportPdf"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "blueprint4llm.openPreview",
        "title": "Blueprint: Open Preview to the Side",
        "category": "Blueprint"
      },
      {
        "command": "blueprint4llm.exportPdf",
        "title": "Blueprint: Export Preview as PDF",
        "category": "Blueprint"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "blueprint4llm.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "blueprint4llm.exportPdf"
        }
      ],
      "editor/title": [
        {
          "command": "blueprint4llm.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "blueprint4llm.exportPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "blueprint4llm.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "blueprint4llm.exportPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Blueprint4llm",
      "properties": {
        "blueprint4llm.preview.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay in milliseconds before rebuilding the Blueprint preview after an edit."
        },
        "blueprint4llm.preview.includeDiagnosticsSummary": {
          "type": "boolean",
          "default": false,
          "description": "Show the error and warning count at the top of generated Blueprint documents."
        }
      }
    }
  },
  "scripts": {
    "preinstall": "npm --prefix .. run build",
    "build": "npm --prefix .. run build && tsc -p .",
    "vscode:prepublish": "npm run build",
    "test:host": "npm run build && node ./out/test/runTest.js",
    "test:package": "npm run build && node ./scripts/package-smoke.mjs",
    "test": "npm run test:host && npm run test:package",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3",
    "yauzl": "^3.2.1"
  },
  "dependencies": {
    "blueprint4llm": "file:..",
    "yaml": "2.9.1"
  }
}
