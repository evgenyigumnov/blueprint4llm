{
  "name": "blueprint4llm",
  "version": "0.22.5",
  "description": "CLI generator of software blueprints: Markdown diagrams, data charts, and UI prototypes to standalone HTML, PDF, SVG, PNG, or JPEG",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgenyigumnov/blueprint4llm.git"
  },
  "homepage": "https://github.com/evgenyigumnov/blueprint4llm#readme",
  "bugs": {
    "url": "https://github.com/evgenyigumnov/blueprint4llm/issues"
  },
  "keywords": [
    "blueprint",
    "markdown",
    "d2",
    "mermaid",
    "vega-lite",
    "plantuml",
    "graphviz",
    "diagrams",
    "ui-prototypes",
    "cli"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "blueprint4llm": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "examples",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest:graphviz": "npm run build",
    "test:graphviz": "vitest run tests/graphviz-diagnostics.test.ts tests/graphviz-renderer.test.ts tests/graphviz-runner.test.ts tests/graphviz-source.test.ts tests/graphviz-svg.test.ts",
    "test:d2-smoke": "vitest run tests/d2-diagnostics.test.ts tests/d2-policy.test.ts tests/d2-renderer.test.ts tests/d2-runner.test.ts tests/d2-svg.test.ts",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@d2lang/d2": "0.1.34",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@plantuml/core": "1.2026.9",
    "@shikijs/rehype": "4.5.0",
    "@viz-js/viz": "3.31.0",
    "ajv": "8.20.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "echarts": "6.1.0",
    "hast-util-from-html": "^2.0.3",
    "jsonc-parser": "^3.3.1",
    "postcss": "8.5.31",
    "puppeteer": "25.14.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
