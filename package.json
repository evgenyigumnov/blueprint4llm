{
  "name": "blueprint4llm",
  "version": "0.7.0",
  "description": "CLI generator of software blueprints: Markdown with Mermaid/PlantUML/Wiremark diagrams to standalone HTML and PDF",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "blueprint4llm": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@plantuml/core": "1.2026.9",
    "@wiremark/core": "^0.1.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "hast-util-from-html": "^2.0.3",
    "puppeteer": "25.14.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
